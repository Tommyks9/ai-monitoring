# Point the local dashboard to the bundled local Agent Runtime.
AGENT_RUNTIME_URL=http://localhost:4000
AGENT_RUNTIME_PORT=4000

# Runtime dispatch:
# - local: runtime simulates agent workers locally
# - webhook: send tasks to real agent runner URLs and block if unavailable
# - hybrid: send to real agent runner URLs when configured, otherwise fallback local
AGENT_RUNTIME_DISPATCHER=true
AGENT_RUNTIME_DISPATCH_INTERVAL_MS=4000
AGENT_DISPATCH_MODE=hybrid

# Optional public URL sent to external runners for callback endpoints.
AGENT_RUNTIME_PUBLIC_URL=http://localhost:4000

# Cursor Agent Worker: run with `npm run cursor-worker`.
AGENT_WORKER_PORT=5050
AGENT_RUNNER_URL=http://localhost:5050/agent-dispatch
# AGENT_RUNNER_LEAD_DEVELOPER_AGENT_URL=http://localhost:5051/dispatch
# AGENT_RUNNER_SHARED_LIB_AGENT_URL=http://localhost:5052/dispatch
# AGENT_RUNNER_TOKEN=

# Command used by the worker to call Cursor Agent/CLI.
# Leave empty to use Thai fallback handoff mode.
# If your Cursor Agent command accepts stdin:
# CURSOR_AGENT_COMMAND=cursor-agent
# If it needs a prompt file, use {promptFile}; output can use {outputFile}.
# CURSOR_AGENT_COMMAND=cursor-agent --prompt-file {promptFile}
CURSOR_AGENT_COMMAND=
CURSOR_AGENT_WORKDIR=.
CURSOR_AGENT_TIMEOUT_MS=600000
CURSOR_AGENT_AUTO_COMPLETE=true

# OpenClaw Agent Worker: run with `npm run openclaw-worker`.
# To use OpenClaw instead of Cursor Worker, point AGENT_RUNNER_URL to port 5055:
# AGENT_RUNNER_URL=http://localhost:5055/agent-dispatch
OPENCLAW_WORKER_PORT=5055
# If OpenClaw is available as a CLI command:
# OPENCLAW_COMMAND=openclaw run --prompt-file {promptFile}
# If OpenClaw is exposed as an HTTP API:
# OPENCLAW_API_URL=http://localhost:6060/agent
# OPENCLAW_API_KEY=
# OPENCLAW_MODEL=
OPENCLAW_TIMEOUT_MS=600000
OPENCLAW_AUTO_COMPLETE=true

# Optional bearer token for private agent runtime APIs.
# This is read server-side by Next.js and must not be prefixed with NEXT_PUBLIC_.
AGENT_RUNTIME_TOKEN=
AGENT_RUNTIME_CORS_ORIGIN=http://localhost:3000