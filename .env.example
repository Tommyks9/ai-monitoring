# Point the local dashboard to the bundled local Agent Runtime.
# Start it in another terminal with: npm run runtime
AGENT_RUNTIME_URL=http://localhost:4000

# Port used by runtime/agent-runtime.mjs.
AGENT_RUNTIME_PORT=4000

# Optional bearer token for private agent runtime APIs.
# This is read server-side by Next.js and must not be prefixed with NEXT_PUBLIC_.
AGENT_RUNTIME_TOKEN=

# Optional CORS origin for direct browser/API testing.
AGENT_RUNTIME_CORS_ORIGIN=http://localhost:3000
